# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub.

# Server port
PORT=5000

# MongoDB connection string.
# Local MongoDB example:
#   MONGO_URI=mongodb://127.0.0.1:27017/todo-list-api
# MongoDB Atlas example (replace <username>, <password>, <cluster-url>, <dbname>):
#   MONGO_URI=mongodb+srv://<mongodb+srv://saadiabdullah133_db_user>:<Warrior333>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/todo-list-api

# Node environment
NODE_ENV=development
