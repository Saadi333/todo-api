{
  "info": {
    "_postman_id": "todo-api-live-pakistan-001",
    "name": "Todo List REST API",
    "description": "CRUD collection for the Week 1 Backend Web Development task — Todo List REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "todoId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "Create Todo (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy groceries\",\n  \"description\": \"Milk, eggs, bread\",\n  \"completed\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Create Todo — Missing Title (400 Bad Request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"This should fail validation\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get All Todos (200 OK)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get Todo By ID (200 OK)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Get Todo By ID — Not Found (404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos/64a000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "64a000000000000000000000"
          ]
        }
      }
    },
    {
      "name": "Update Todo (200 OK)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Update Todo — Invalid ID (400 Bad Request)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/todos/not-a-valid-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "not-a-valid-id"
          ]
        }
      }
    },
    {
      "name": "Delete Todo (200 OK)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/todos/{{todoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "{{todoId}}"
          ]
        }
      }
    },
    {
      "name": "Delete Todo — Not Found (404)",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/todos/64a000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "64a000000000000000000000"
          ]
        }
      }
    }
  ]
}